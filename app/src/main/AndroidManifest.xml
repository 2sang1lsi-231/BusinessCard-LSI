<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="명함관리 LSI"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <provider
            android:name=".CardFileProvider"
            android:authorities="com.lsi.businesscard.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity android:name=".EditActivity" android:exported="false" />
        <activity android:name=".DetailActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
